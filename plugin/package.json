{
  "name": "dsh-skin-mistblue",
  "version": "1.0.1",
  "description": "Mistblue (雾蓝) — a DeepSeek-web inspired translucent glass skin for DeepSeek Harness: airy ambient background, liquid-glass surfaces, readability-tiered blur for cards, popups and detail panels.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HewangLan0511/dsh-ui.git"
  },
  "homepage": "https://github.com/HewangLan0511/dsh-ui#readme",
  "bugs": {
    "url": "https://github.com/HewangLan0511/dsh-ui/issues"
  },
  "type": "module",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "deepseek",
    "skin",
    "theme",
    "glass",
    "glassmorphism",
    "cordis",
    "plugin"
  ],
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "locale/*.json",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-theme"
      ]
    }
  },
  "peerDependencies": {
    "react": "^18.2.0"
  },
  "engines": {
    "node": ">=18"
  }
}
